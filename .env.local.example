# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Configuration
NEXT_PUBLIC_DEFAULT_COUNTRY=CO
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_MOCK_DATA=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true
NEXT_PUBLIC_ENABLE_BIOMETRIC_AUTH=false

# Sentry Error Monitoring
NEXT_PUBLIC_SENTRY_DSN=           # Client-side Sentry DSN (from Sentry project settings)
SENTRY_ORG=                        # Sentry organization slug
SENTRY_PROJECT=                    # Sentry project slug
SENTRY_AUTH_TOKEN=                 # Auth token for source map uploads (CI only)
